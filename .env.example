# Copy this file to .env (same folder) and fill in the key. .env is ignored by git.
GEMINI_API_KEY=
# The model that reads the claim, picks the design and judges. Others: gemini-3.1-flash-lite, gemini-4-hydrogen
GEMINI_MODEL=gemini-3.5-flash-lite
# The model for web-search calls (the free tier has no Google Search allowance on Gemini 3 models)
GEMINI_WEB_MODEL=gemini-2.5-flash-lite
# The model that writes helper scripts (defaults to GEMINI_MODEL when left out)
# GEMINI_HELPER_MODEL=gemini-3.5-flash-lite
# Requests per minute to stay under, per model. The free tier is tight; raise it on a paid key.
GEMINI_RPM=5
# When a claim comes with data and you declared no design or roles, a model reads the claim and audits it,
# and the report is computed under its reading. auto = use Gemini when the key above is set; off = never.
CAUSAL_MODEL_AUDIT=auto
# The executive summary, the Investigator chat, literature investigations and claim-only checks also run on Gemini
# when GEMINI_API_KEY is set. CAUSAL_LLM forces a backend: gemini | api (needs ANTHROPIC_API_KEY) | fake | off.
# CAUSAL_LLM=gemini
